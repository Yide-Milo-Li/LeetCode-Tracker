# ==============================================================================
# LeetCode Tracker Environment Configuration Template
# ==============================================================================
# Copy this file to .env to configure local environment variables.
# All settings are optional; defaults are chosen for safe, local-only operation.
#
# Note: AI provider credentials can also be configured directly in the desktop UI
# under Settings (Settings -> AI Configuration) without editing this file.
# ==============================================================================

# Server & Network Configuration
PORT=3000
HOST=127.0.0.1

# Storage Paths (Optional - defaults to .local directory in repository root)
# LOCAL_DIR=./.local
# DB_PATH=./.local/tracker.sqlite

# Google Gemini Configuration (models/gemini-3.8-flash | models/gemini-4-hydrogen)
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=models/gemini-4-hydrogen
# GEMINI_REASONING_EFFORT=medium

# OpenAI Configuration (Optional: gpt-6-luna | gpt-6.1-terra)
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=medium

# DeepSeek Configuration (Optional: deepseek-flash)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_REASONING_EFFORT=high

# Google Drive device sync for source runs (optional; Settings -> Data takes precedence).
# Official installers use the built-in LCT client.
# Use a Google Cloud OAuth client of type "Desktop app" with its consent screen set to
# "In production" (Testing mode refresh tokens expire after 7 days). See docs/sync.md.
# GOOGLE_OAUTH_CLIENT_ID=your_desktop_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_desktop_client_secret
