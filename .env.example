# ==============================================================================
# LeetCode Tracker Environment Configuration Template
# ==============================================================================
# Copy this file to .env to configure local environment variables.
# All settings are optional; defaults are chosen for safe, local-only operation.
#
# Note: AI provider credentials can also be configured directly in the desktop UI
# under Settings (Settings -> AI Configuration) without editing this file.
# ==============================================================================

# Server & Network Configuration
PORT=3000
HOST=127.0.0.1

# Storage Paths (Optional - defaults to .local directory in repository root)
# LOCAL_DIR=./.local
# DB_PATH=./.local/tracker.sqlite

# Google Gemini Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=models/gemini-3.5-flash-lite

# OpenAI Configuration (Optional)
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek Configuration (Optional)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
