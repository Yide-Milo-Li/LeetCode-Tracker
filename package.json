{
  "name": "leetcode-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "packages/contracts",
    "packages/database",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "vite apps/web",
    "build": "vite build apps/web",
    "start": "node apps/server/src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/catalog-store.test.ts tests/server-api.test.ts",
    "test:private": "node --test tests/private-backup.test.ts",
    "restore": "node scripts/restore-backup.ts",
    "docs:check": "node scripts/check-docs.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.12.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
