{
  "name": "leetcode-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "packages/contracts",
    "packages/database",
    "packages/domain",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "vite apps/web",
    "build": "vite build apps/web",
    "start": "node apps/server/src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/phase4-closure-verification.test.ts tests/phase5-closure-verification.test.ts tests/planning-remediation.test.ts tests/time.test.ts tests/catalog-store.test.ts tests/server-api.test.ts tests/review-regressions.test.ts tests/practice-store.test.ts tests/server-practice-api.test.ts tests/planning-domain-store.test.ts tests/server-planning-api.test.ts tests/dashboard-domain-store.test.ts tests/server-dashboard-api.test.ts && npm run test:web",
    "test:private": "node --test tests/private-backup.test.ts",
    "restore": "node scripts/restore-backup.ts",
    "docs:check": "node scripts/check-docs.ts",
    "test:web": "node --import tsx --test tests/web-components.test.tsx tests/web-planning-components.test.tsx tests/web-dashboard-components.test.tsx"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.12.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  }
}
